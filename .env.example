# DashScope / 阿里云百炼（仅服务端，切勿 NEXT_PUBLIC_ 暴露）
DASHSCOPE_API_KEY=sk-xxx

# 地域 endpoint（国内默认北京）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认模型（须命中 lib/ai/models.ts 目录；左栏顶部可在 UI 内切换）
DASHSCOPE_MODEL=deepseek-v4.1-flash

# 强制 Mock（无 Key 时也会自动 Mock）
FORGE_FORCE_MOCK=false

# 热点雷达 / 爆款线索默认搜索关键词（得物优先）
FORGE_TREND_QUERY=得物 热门球鞋 潮穿 爆款 社区热搜 2026

# 视觉第二氛围方案（额外 1 次 API，默认关闭）
FORGE_ENABLE_VISUAL_VARIANT=false
